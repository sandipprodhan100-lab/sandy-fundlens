# ==============================================================================
# Airflow Environment Variables Template
# Copy to .env in data-platform/airflow/
# ==============================================================================

AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# AWS S3 Settings
AWS_S3_BUCKET=mutualfundlens-s3
AWS_DEFAULT_REGION=ap-south-1

# Snowflake Credentials (Used by Airflow Connections & dbt)
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1
SNOWFLAKE_USER=FUNDLENS_DEV_USER
SNOWFLAKE_PASSWORD=YourStrongPasswordHere
SNOWFLAKE_DATABASE=FUNDLENS_DW
SNOWFLAKE_WAREHOUSE=FUNDLENS_WH
SNOWFLAKE_ROLE=FUNDLENS_TRANSFORMER_ROLE
