# ==============================================================================
# FundLens dbt Environment Variables
# Copy to .env in data-platform/dbt_fundlens/ if using dotenv
# ==============================================================================

# Snowflake Account Identifier
# Run in Snowflake: SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
# Example: "ORGNAME-ACCOUNTNAME" or "ab12345.ap-south-1"
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1

# Snowflake User Credentials
SNOWFLAKE_USER=FUNDLENS_DEV_USER
SNOWFLAKE_PASSWORD=YourSecurePassword123!

# Target Warehouse, Database & Role (Pre-configured in snowflake/01_setup_database_warehouse.sql)
SNOWFLAKE_DATABASE=FUNDLENS_DW
SNOWFLAKE_WAREHOUSE=FUNDLENS_WH
SNOWFLAKE_ROLE=FUNDLENS_TRANSFORMER_ROLE
