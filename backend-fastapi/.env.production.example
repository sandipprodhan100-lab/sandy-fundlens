# Production Environment Configuration Template for Backend (FastAPI)

# Google Gemini API Key (ReAct Agent & Compliance Engine)
GEMINI_API_KEY="your-google-gemini-api-key"

# Database Connection (Supabase / TimescaleDB / Managed Postgres)
DATABASE_URL="postgresql://postgres:your-secure-password@localhost:5432/fundlens"

# Redis Cache URL
REDIS_URL="redis://:your-redis-password@localhost:6379/0"

# AWS S3 / Cloudflare R2 Data Lake Configuration (For Historical NAV Parquet Files)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="fundlens-nav-parquet"

# Environment Mode
ENVIRONMENT="production"
DEBUG="false"
ALLOWED_ORIGINS="https://sandipprodhan.in,https://www.sandipprodhan.in,https://fundlens.sandipprodhan.in"
