{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mflens",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "sandipprodhan.in", "custom_domain": true },
    { "pattern": "www.sandipprodhan.in", "custom_domain": true },
    { "pattern": "fundlens.sandipprodhan.in", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  // Non-secret environment variables (safe to commit)
  "vars": {
    "AWS_REGION": "ap-south-1",
    "AWS_S3_BUCKET": "mutualfundlens-s3",
    "VITE_APP_EDITION": "open",
    "SUPABASE_URL": "https://zjdrkfawfhgystldlpww.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_8NbENyyUDUqo_aKK4xIy7A_IH31NPq8",
    "VITE_SUPABASE_URL": "https://zjdrkfawfhgystldlpww.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_8NbENyyUDUqo_aKK4xIy7A_IH31NPq8",
    "VITE_SUPABASE_PROJECT_ID": "zjdrkfawfhgystldlpww"
  }
}