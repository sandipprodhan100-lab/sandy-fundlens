{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mflens",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "sandipprodhan.in", "custom_domain": true },
    { "pattern": "www.sandipprodhan.in", "custom_domain": true },
    { "pattern": "fundlens.sandipprodhan.in", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  }
}